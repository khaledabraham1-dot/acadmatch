# E-mail optionnel pour la boucle de feedback MVP (Étape 9).
# Si défini, le bouton "Envoyer mon avis" ouvre un mailto prérempli.
# Sans cette variable, l'avis reste uniquement en localStorage sur l'appareil.
NEXT_PUBLIC_FEEDBACK_EMAIL=

# Comptes utilisateurs (Phase 5, optionnel) — voir docs/accounts-setup.md.
# Sans ces variables, /compte affiche "bientôt disponible" et le reste de
# l'app fonctionne exactement comme avant (localStorage uniquement).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Serveur uniquement (jamais NEXT_PUBLIC_) — ne jamais exposer au navigateur.
SUPABASE_SECRET_KEY=
